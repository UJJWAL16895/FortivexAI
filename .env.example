# Copy to .env and enter credentials only in that local file.
GEMINI_API_KEY=replace_with_your_gemini_key
# Optional. A non-empty key alone does not establish usable credit.
OPENAI_API_KEY=
AGENT_MODE=mock
# Verified with this project's key. Recheck access with your own project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Provisional backup chosen in STEP-003. OpenAI remains opt-in after credit verification.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING=minimal
GEMINI_FALLBACK_THINKING=minimal
GEMINI_RPM=8
GEMINI_DAILY=60
GEMINI_TPM=12000
ALLOW_FALLBACK_DEMO=false
OPENAI_MODEL=
